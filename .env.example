# Copy to .env.local and fill in. Never commit real values. See ENVIRONMENT_SETUP.md.
APP_ENV=local
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
NEXT_PUBLIC_AUTH_GOOGLE_ENABLED=false

# Server-only secrets (privileged code, jobs). Leave empty until needed.
SUPABASE_SECRET_KEY=
JOBS_SECRET=

# Email (Resend) and file scanning (ClamAV REST). Leave empty to skip sending and scanning.
RESEND_API_KEY=
EMAIL_FROM=
CLAMAV_URL=
